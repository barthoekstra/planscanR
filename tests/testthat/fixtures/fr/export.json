[{"dc_title": "Projet de centrale solaire de Lyreco", "descriptif_du_projet": "Le projet de parc photovoltaïque de Lyreco se localise dans la région Pays de la Loire, au nord du département de La Mayenne (53). Il se situe à 25 km de la ville de Mayenne et la zone du projet de parc photovoltaïque s’inscrit sur la commune de Villaines-la-Juhel.\r\nLa puissance de la centrale solaire est d'environ 4,2 MWc.", "dc_description_abstract": null, "dc_description_freetext": null, "dc_subject_category": ["Ouvrages de production d'électricité à partir de l'énergie solaire"], "dc_subject_theme": ["ÉNERGIE"], "vp_status": "clos", "dc_type": ["Autorisation au titre du code de l'environnement", "Permis de construire"], "vp_creator_corporatename": null, "dc_contributor": null, "dc_creator_personalname": null, "dc_contributor_corporatename": "-", "contact_du_bureau_d_etude": null, "diffuseur": "_sicodei_eco4_", "dc_date": "2025-06-18T13:23:16+00:00", "dc_date_issued": "2033-09-03", "dc_disposal_date": null, "dc_coverage": null, "localisation": {"type": "Feature", "geometry": {"coordinates": [[[[-0.279593468, 48.336425777], [-0.280365944, 48.333658465], [-0.282168388, 48.333401696], [-0.285944939, 48.333259047], [-0.286974907, 48.333259047], [-0.28731823, 48.333430226], [-0.286974907, 48.334286116], [-0.286889076, 48.335598452], [-0.282769203, 48.335741095], [-0.280365944, 48.336454305], [-0.279593468, 48.336425777]]]], "type": "MultiPolygon"}, "properties": {}}, "coverage_temporal": null, "dc_coverage_temporal_periodoftime": 30, "modalite_de_participation_du_public": null, "type_de_public": null, "format_de_l_affichage": null, "adresse_url": null, "source": "TPS", "langue_de_publication": null, "dc_relation": null, "dc_relation_websitedebate": "http://www.mayenne.gouv.fr/Politiques-publiques/Environnement-eau-et-biodiversite/Enquetes-publiques-hors-ICPE-Commissaires-enqueteurs/Divers/Centrale-photovoltaique-Quadran-a-Villaines-la-Juhel", "dc_relation_websiteowner": null, "date_avis_p