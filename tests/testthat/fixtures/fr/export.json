on de 10 éoliennes d’une puissance unitaire comprise entre 4,5 MW et 6,2 MW, pour une puissance totale comprise entre 45 et 59,9 MW, sur les communes de Le Chêne et de L’Ormes, dans le département de l’Aube. La production annuelle estimée est de 136 400 MWh, correspondant à la consommation électrique d’environ 27 280 foyers. Ce projet a pour objectif de produire une électricité verte tout en limitant au maximum ses impacts sur l’environnement. À ce titre, l’implantation retenue garantit une intégration paysagère cohérente et une harmonie visuelle à l’échelle locale.", "dc_description_abstract": null, "dc_description_freetext": null, "dc_subject_category": ["Parcs éoliens soumis à autorisation mentionnés par la rubrique ICPE 2980"], "dc_subject_theme": ["ENVIRONNEMENT"], "vp_status": "ouvert", "dc_type": ["AENV"], "vp_creator_corporatename": null, "dc_contributor": null, "dc_creator_personalname": null, "dc_contributor_corporatename": "-", "contact_du_bureau_d_etude": null, "diffuseur": "_sicodei_eco4_", "dc_date": "2026-06-03T00:31:40+00:00", "dc_date_issued": "2041-06-22", "dc_disposal_date": null, "dc_coverage": null, "localisation": null, "coverage_temporal": null, "dc_coverage_temporal_periodoftime": 92, "modalite_de_participation_du_public": null, "type_de_public": null, "format_de_l_affichage": null, "adresse_url": null, "source": "GUNenv", "langue_de_publication": null, "dc_relation": null, "dc_relation_websitedebate": null, "dc_relation_websiteowner": null, "date_avis_publication": null, "dc_relation_officialdocument": "https://sicodei.projets-environnement.gouv.fr/2026/06/03/200001/200001_DCZIP.zip", "dc_relation_informationnote": "https://sicodei.projets-environnement.gouv.fr/2026/06/03/D001791384/AP EP PCICP2026147-0004 - PE DE L'ORMES ET DU CHENE.pdf", "dc_relation_extension_erc": null, "dc_relation_extension_biodiv": null, "dc_relation_extension_photos": null, "dc_relation_extension_plan": null, "dc_relation_expertise_etudeimpact": "https://sicodei.proj